# Generated by the Doctbase native installer. DO NOT EDIT.
# Installed to /etc/systemd/system/doctbase-pgbouncer.service
[Unit]
Description=Doctbase PgBouncer (transaction pooling over Unix socket)
Documentation=https://doctbase.dev/docs
After=network-online.target postgresql@18-doctbase.service
Requires=postgresql@18-doctbase.service
PartOf=doctbase.target

[Service]
Type=simple
User=doctbase-pgbouncer
Group=doctbase
ExecStart=/usr/sbin/pgbouncer --quiet /etc/doctbase/generated/pgbouncer.ini
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/doctbase /var/lib/doctbase/pgbouncer
UMask=0007
LoadCredential=pgbouncer_auth:/etc/doctbase/secrets/pgbouncer_auth

[Install]
WantedBy=doctbase.target
