# Generated by the Doctbase native installer. DO NOT EDIT.
# Installed to /etc/systemd/system/doctbase-caddy.service
[Unit]
Description=Doctbase Caddy edge (TLS and project routing)
Documentation=https://doctbase.dev/docs
After=network-online.target
Wants=network-online.target
PartOf=doctbase.target

[Service]
Type=exec
User=doctbase-caddy
Group=doctbase
ExecStart=/usr/bin/caddy run --config /etc/doctbase/generated/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/doctbase/generated/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
# The process binds 80/443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/doctbase /var/lib/doctbase/caddy
UMask=0007
LimitNOFILE=65536

[Install]
WantedBy=doctbase.target
