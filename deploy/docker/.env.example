# Local / standalone compose values.
#
# Coolify generates SERVICE_PASSWORD_* and SERVICE_FQDN_* on first deploy, so
# this file is not needed there. For plain `docker compose`, copy it to .env.
#
# Never commit .env.

# Generated secrets (replace before any non-local use).
SERVICE_PASSWORD_64_INTERNALTOKEN=dev-internal-token-change-me
SERVICE_PASSWORD_64_POSTGRES=dev-postgres-password-change-me

# Images / instance / build
ZIG_VERSION=0.17.1
DOCTBASE_VERSION=dev
DOCTBASE_INSTANCE_NAME=doctbase
DOCTBASE_DOMAIN=
DOCTBASE_ADMIN_EMAIL=

# Deployment mode: external proxy (Coolify/Traefik) by default.
DOCTBASE_PROXY_MODE=external
DOCTBASE_LOG_LEVEL=info

# Database: "external" uses a PostgreSQL you provide; "managed" pairs with
# COMPOSE_PROFILES=bundled (postgres + pgbouncer).
DOCTBASE_DATABASE_MODE=external
POSTGRES_DB=doctbase
POSTGRES_USER=doctbase

# Empty = external database. Set to "bundled" to start postgres + pgbouncer,
# or "bundled,optional" to also start optional services.
COMPOSE_PROFILES=
