name: @INSTANCE_NAME@

# Generated by `doctbase init --profile docker`. DO NOT EDIT.
#
# Standalone Docker deployment: Caddy publishes 80/443 and terminates TLS.
# Core services stay on the private Compose network. For platform-managed
# proxies (Coolify/Traefik), use deploy/docker/compose.yml instead, which does
# not publish ports.
#
# Secrets are interpolated from the generated .env file next to this file.

services:
  gateway:
    image: @IMAGE_PREFIX@/gateway:@VERSION@
    init: true
    restart: unless-stopped
    environment:
      DOCTBASE_MODE: docker
      DOCTBASE_CONFIG: /etc/doctbase/doctbase.toml
      DOCTBASE_CONFIG_MANAGED: "1"
      DOCTBASE_LISTEN: 0.0.0.0:8080
      DOCTBASE_HTTP_PORT: "8080"
      DOCTBASE_INSTANCE_NAME: ${DOCTBASE_INSTANCE_NAME:-doctbase}
      DOCTBASE_DOMAIN: ${DOCTBASE_DOMAIN:-}
      DOCTBASE_ADMIN_EMAIL: ${DOCTBASE_ADMIN_EMAIL:-}
      DOCTBASE_PROXY_MODE: ${DOCTBASE_PROXY_MODE:-caddy}
      DOCTBASE_DATABASE_MODE: ${DOCTBASE_DATABASE_MODE:-external}
      DOCTBASE_POOLER_ENABLED: ${DOCTBASE_POOLER_ENABLED:-false}
      DOCTBASE_LOG_LEVEL: ${DOCTBASE_LOG_LEVEL:-info}
      DOCTBASE_INTERNAL_TOKEN: ${SERVICE_PASSWORD_64_INTERNALTOKEN:?internal token is required}
    expose:
      - "8080"
    volumes:
      - doctbase-data:/var/lib/doctbase
    healthcheck:
      test: ["CMD", "/usr/local/bin/healthcheck.sh"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s

  management:
    image: @IMAGE_PREFIX@/management:@VERSION@
    init: true
    restart: unless-stopped
    environment:
      DOCTBASE_MODE: docker
      DOCTBASE_CONFIG: /etc/doctbase/doctbase.toml
      DOCTBASE_CONFIG_MANAGED: "1"
      DOCTBASE_LISTEN: 0.0.0.0:8081
      DOCTBASE_HTTP_PORT: "8081"
      DOCTBASE_INSTANCE_NAME: ${DOCTBASE_INSTANCE_NAME:-doctbase}
      DOCTBASE_DOMAIN: ${DOCTBASE_DOMAIN:-}
      DOCTBASE_ADMIN_EMAIL: ${DOCTBASE_ADMIN_EMAIL:-}
      DOCTBASE_PROXY_MODE: ${DOCTBASE_PROXY_MODE:-caddy}
      DOCTBASE_DATABASE_MODE: ${DOCTBASE_DATABASE_MODE:-external}
      DOCTBASE_POOLER_ENABLED: ${DOCTBASE_POOLER_ENABLED:-false}
      DOCTBASE_LOG_LEVEL: ${DOCTBASE_LOG_LEVEL:-info}
      DOCTBASE_INTERNAL_TOKEN: ${SERVICE_PASSWORD_64_INTERNALTOKEN:?internal token is required}
    expose:
      - "8081"
    volumes:
      - doctbase-data:/var/lib/doctbase
    healthcheck:
      test: ["CMD", "/usr/local/bin/healthcheck.sh"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s

  caddy:
    image: caddy:2
    init: true
    restart: unless-stopped
    depends_on:
      - gateway
      - management
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy-data:/data
      - caddy-config:/config
    healthcheck:
      test: ["CMD", "caddy", "version"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  # Optional service. Enable with COMPOSE_PROFILES=bundled,optional or
  # COMPOSE_PROFILES=optional in .env.
  auth:
    profiles: ["optional"]
    image: @IMAGE_PREFIX@/auth:@VERSION@
    init: true
    restart: unless-stopped
    environment:
      DOCTBASE_MODE: docker
      DOCTBASE_CONFIG: /etc/doctbase/doctbase.toml
      DOCTBASE_CONFIG_MANAGED: "1"
      DOCTBASE_LISTEN: 0.0.0.0:8082
      DOCTBASE_HTTP_PORT: "8082"
      DOCTBASE_INSTANCE_NAME: ${DOCTBASE_INSTANCE_NAME:-doctbase}
      DOCTBASE_DOMAIN: ${DOCTBASE_DOMAIN:-}
      DOCTBASE_PROXY_MODE: ${DOCTBASE_PROXY_MODE:-caddy}
      DOCTBASE_DATABASE_MODE: ${DOCTBASE_DATABASE_MODE:-external}
      DOCTBASE_POOLER_ENABLED: ${DOCTBASE_POOLER_ENABLED:-false}
      DOCTBASE_LOG_LEVEL: ${DOCTBASE_LOG_LEVEL:-info}
      DOCTBASE_INTERNAL_TOKEN: ${SERVICE_PASSWORD_64_INTERNALTOKEN:?internal token is required}
    expose:
      - "8082"
    volumes:
      - doctbase-data:/var/lib/doctbase
    healthcheck:
      test: ["CMD", "/usr/local/bin/healthcheck.sh"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 15s

  # Bundled database. Enable with COMPOSE_PROFILES=bundled and set
  # DOCTBASE_DATABASE_MODE=managed in .env.
  postgres:
    profiles: ["bundled"]
    image: postgres:18
    restart: unless-stopped
    environment:
      POSTGRES_DB: ${POSTGRES_DB:-doctbase}
      POSTGRES_USER: ${POSTGRES_USER:-doctbase}
      POSTGRES_PASSWORD: ${SERVICE_PASSWORD_64_POSTGRES:?database password is required}
    expose:
      - "5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s

  pgbouncer:
    profiles: ["bundled"]
    image: edoburu/pgbouncer:v1.24.1-p0
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      DB_HOST: postgres
      DB_PORT: "5432"
      DB_USER: ${POSTGRES_USER:-doctbase}
      DB_PASSWORD: ${SERVICE_PASSWORD_64_POSTGRES:?database password is required}
      POOL_MODE: transaction
      AUTH_TYPE: scram-sha-256
      MAX_CLIENT_CONN: "1000"
      DEFAULT_POOL_SIZE: "10"
    expose:
      - "6432"
    healthcheck:
      test: ["CMD-SHELL", "nc -z 127.0.0.1 6432"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 10s

volumes:
  doctbase-data:
  caddy-data:
  caddy-config:
  postgres-data:
